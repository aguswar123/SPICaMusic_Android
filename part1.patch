+/** When a background vocal opens: shortly before it starts, or with the line when it starts almost with the main lyric. */
+private fun accompanimentOpenAtMs(
+    background: LyricItem.WordsLyric.AccompanimentLyric,
+    lyric: LyricItem.WordsLyric,
+): Long {
+    val mainStart = lyric.words.firstOrNull()?.startTime ?: lyric.startTime
+    val startsWithMain = abs(background.startTime - mainStart) <= LyricUIConstants.ACCOMPANIMENT_OPEN_LEAD_MS
+    return if (startsWithMain) lyric.startTime else background.startTime - LyricUIConstants.ACCOMPANIMENT_OPEN_LEAD_MS
