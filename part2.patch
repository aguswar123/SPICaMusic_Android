+/** One romanization word above/below its lyric word (an empty one only reserves the height). */
+@Composable
+private fun AttachedTransliteration(
+    text: String,
+    style: TextStyle,
+    color: Color,
+) {
+    Text(
+        text = text.ifBlank { "\u200B" },
+        style = style,
+        color = color.copy(alpha = 0.92f),
+        maxLines = 1,
+        softWrap = false,
+    )
+}
